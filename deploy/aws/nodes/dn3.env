# DataNode: guarda bloques cifrados y se registra con heartbeat en el ControlNode.
# Conoce a los dos ControlNodes: si el primario cae, se reporta al que quede.
DFSHA_APP=dfsha.server.datanode:app
DFSHA_NODE_ID={{NODE}}
DFSHA_DATANODE_URL=https://{{SELF_EIP}}:8000
DFSHA_CONTROL_URLS=https://{{EIP_cn1}}:8000,https://{{EIP_cn2}}:8000
DFSHA_CONTROL_CA=/certs/ca.crt
